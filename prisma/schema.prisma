generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum AttendanceStatus {
  ATTENDING
  NOT_ATTENDING
  MAYBE
}

// How a guest got to the venue, recorded by an usher at check-in for parking.
enum Vehicle {
  MOTORCYCLE
  CAR
}

model Guest {
  id                String          @id @default(cuid())
  // The guest's invitation link is /?id=<code>. Random, so links can't be
  // guessed or walked; assigned once by prisma/seed.ts and never changed.
  code              String          @unique
  name              String
  // Shown instead of name on the cover greeting, e.g. "Keluarga Budi".
  groupLabel        String?
  // Which list the guest came from, e.g. "Teman Mega · Kuliah". Only shown
  // in /admin, to tell guests with the same name apart.
  side              String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  viewedAt          DateTime?
  // Set by an usher on the wedding day from /admin; null until the guest arrives.
  checkedInAt       DateTime?
  vehicle           Vehicle?
  // How many people actually came, counted by the usher at check-in. Kept
  // apart from Rsvp.numberOfGuests, which is what the guest said beforehand.
  arrivedGuestCount Int?
  rsvp              Rsvp?
  ucapanMessages    UcapanMessage[]
}

model Rsvp {
  id             String            @id @default(cuid())
  guest          Guest             @relation(fields: [guestId], references: [id])
  guestId        String            @unique
  // Nullable: a guest can leave an Ucapan & Doa message before (or without)
  // ever tapping Hadir/Tidak Hadir on the RSVP bar, so this row may exist
  // with attendance still unset.
  attendance     AttendanceStatus?
  numberOfGuests Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

// A guest can leave more than one Ucapan & Doa message, so these live in
// their own one-to-many table instead of the singleton Rsvp row.
model UcapanMessage {
  id        String   @id @default(cuid())
  guest     Guest    @relation(fields: [guestId], references: [id])
  guestId   String
  message   String
  createdAt DateTime @default(now())

  @@index([guestId])
}
